        <!-- Notes -->
        <mxCell id="note_calc" value="Công thức Hóa đơn hàng tháng:&#xa;• Tiền điện = (chỉ số mới - chỉ số cũ) × Đơn giá điện (từ HĐ)&#xa;• Tiền nước = (chỉ số mới - chỉ số cũ) × Đơn giá nước (từ HĐ)&#xa;• Tiền dịch vụ = Đơn giá dịch vụ × Số người ở&#xa;• Tổng = Tiền phòng + Tiền điện + Tiền nước + Tiền dịch vụ" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffffff;strokeColor=#000000;fontSize=11;size=15;" vertex="1" parent="1">
